NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/fo_portal?schema=public"

# JWT
JWT_ACCESS_SECRET=change_this_access_secret_to_long_random_string
JWT_REFRESH_SECRET=change_this_refresh_secret_to_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Upload
MAX_FILE_SIZE_MB=20
UPLOAD_DIR=./storage

# Validation Tolerances
ROUTE_LENGTH_TOLERANCE_PERCENT=5
PRICE_TOLERANCE_PERCENT=0
PRICE_EXACT_MATCH=true

# Geocoding (Nominatim)
NOMINATIM_USER_AGENT=FO-Geomap-Portal/1.0
NOMINATIM_EMAIL=admin@portal.local

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Seed (development only)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@portal.local
